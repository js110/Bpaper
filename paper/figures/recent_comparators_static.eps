/box { /h exch def /w exch def /y exch def /x exch def newpath x y moveto w 0 rlineto 0 h rlineto w neg 0 rlineto closepath 1 setgray fill 0 setgray 1.2 setlinewidth stroke } bind def
/arrow { /y2 exch def /x2 exch def /y1 exch def /x1 exch def newpath x1 y1 moveto x2 y2 lineto 1.2 setlinewidth stroke /ang y2 y1 sub x2 x1 sub atan def gsave x2 y2 translate ang rotate newpath 0 0 moveto -9 4 lineto -9 -4 lineto closepath fill grestore } bind def
/line { newpath moveto lineto stroke } bind def
